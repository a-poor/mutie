  "direct_test_names": [
    "adfToText flattens a document with headings, paragraphs, and lists",
    "adfToText is safe on empty / unknown nodes",
    "htmlToText strips tags, scripts, and entities",
    "basicAuthHeader base64-encodes email:token",
    "DEFAULT_CONFIG_PATH ends in bragkit/config.json",
    "load of a missing file returns {} and never throws",
    "load of invalid JSON returns {} (does not throw)",
    "load of non-object JSON (array/number) returns {}",
    "save + load round-trips a config object",
    "get reads dotted keys, undefined for missing",
    "set writes dotted keys immutably (returns new object, leaves input intact)",
    "set on a top-level key works",
    "mergeFlags precedence: flag > config > default",
    "emits the fixed header row first",
    "one row per achievement plus the header",
    "header only when there are no achievements",
    "joins tags with semicolons inside one field",
    "escapes commas by wrapping the field in double quotes",
    "escapes double quotes by doubling them and wrapping",
    "escapes embedded newlines by quoting the field",
    "is deterministic for the same input",
    "missing fields render as empty cells, not 'undefined'",
    "parseDate handles ISO, relative, and today",
    "parseDate throws on garbage",
    "parsePeriod resolves a year",
    "parsePeriod resolves a quarter",
    "parsePeriod resolves an explicit range",
    "impactScore rewards code volume, reactions, and story points",
    "impactScore caps code-volume contribution so one huge PR can't dominate",
    "computeMetrics sums across types and metadata",
    "topByImpact ranks highest-impact first",
    "every advertised template renders without throwing",
    "timeline links titles and groups by date",
    "by-project groups under repository and sorts by volume",
    "executive-summary tallies by source and type",
    "render rejects an unknown template",
    "countReactions sums reaction counts",
    "topReactions returns the most-used emoji, formatted",
    "cleanSlackText resolves mentions, links, and entities",
    "extractTitle uses the first line, strips formatting, truncates",
    "isLikelyKudos requires both a mention of the user and positive sentiment",
    "upsert is idempotent on id (no duplicate rows)",
    "query filters by source, type, and date range; newest first",
    "tags and metadata round-trip through JSON columns",
    "stats aggregates totals and breakdowns",
    "collection runs are recorded and queryable, newest first",
    "lastSuccess returns the until of the latest successful run for a source",
    "upsert rejects malformed achievements",
    "extractTicketKeys finds distinct tracker keys",
    "extractTicketKeys ignores tech/standards lookalikes",
    "autoTag adds ticket keys as tags and as metadata.relatedKeys",
    "a PR and its Jira issue share the same ticket tag (dedup hint)",
    "autoTag returns the same object when nothing changes",
    "normalizeTags trims, drops empties, de-dupes, preserves order",
    "groupByMonth buckets by UTC month with per-type counts",
    "groupByMonth buckets by UTC, not local time, and skips bad dates",
    "groupByMonth returns [] for no achievements",
    "renderTrend includes the heading, a known month, and the table",
    "renderTrend handles an empty period gracefully",
    "salaryAnalysis renders a band label and frames it as inputs",
    "salaryAnalysis does not anchor when medians are placeholder zeroes"
  ],
